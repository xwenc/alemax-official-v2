# Copy to the repository root as .env.ec2; never commit that file.
ENVIRONMENT=production
# Loopback only, avoids the CRM default port 3000 on a shared instance.
WEB_PORT=3100
MYSQL_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
# Separate schema/account inside the existing CRM MySQL server.
MYSQL_DATABASE=alemaxsite
MYSQL_USER=alemaxsite
MYSQL_HOST=mysql
CRM_MYSQL_NETWORK=alemax_shared
INTERNAL_API_KEY=REPLACE_WITH_ANOTHER_64_HEX_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD
ADMIN_SESSION_SECRET=REPLACE_WITH_ANOTHER_64_HEX_SECRET
SITE_ORIGINS=https://www.alemaxglobal.com,https://alemaxglobal.com
# Imports the checked-in CMS seed only if the content table is empty.
CMS_SEED_ON_START=false
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
DEEPL_GLOSSARY_ID=
# Required for public inquiry submission in production.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
INQUIRY_TO=info@alemaxglobal.com

# First-party IP/day visit counts. Requires the supplied trusted Caddy header.
VISIT_STATS_ENABLED=true
# Optional independent 32+ character secret; defaults to INTERNAL_API_KEY.
VISIT_HASH_SECRET=
