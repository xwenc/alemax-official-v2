# Use long, unique alphanumeric passwords; URL-encode other characters in DATABASE_URL.
MYSQL_PASSWORD=replace_with_unique_database_password
MYSQL_ROOT_PASSWORD=replace_with_unique_root_password
INTERNAL_API_KEY=replace_with_unique_internal_service_key
ENVIRONMENT=production
WEB_PORT=3000
# Create a Cloudflare Turnstile site for your domain and fill both keys.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
