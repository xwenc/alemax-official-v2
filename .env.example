# Use long, unique alphanumeric passwords; URL-encode other characters in DATABASE_URL.
MYSQL_PASSWORD=replace_with_unique_database_password
MYSQL_ROOT_PASSWORD=replace_with_unique_root_password
INTERNAL_API_KEY=replace_with_unique_internal_service_key
ENVIRONMENT=production
ADMIN_USERNAME=admin
# Set a strong administrator password and a separate random session secret.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional automatic EN -> ES translation. Without a key, edit Spanish manually.
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
DEEPL_GLOSSARY_ID=
WEB_PORT=3000
# Create a Cloudflare Turnstile site for your domain and fill both keys.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Exact public origins, comma-separated. Include scheme and port when needed.
SITE_ORIGINS=https://www.alemaxglobal.com,https://alemaxglobal.com
# SMTP runs only on the Next.js server. 465 uses TLS; 587 requires STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Bare email address authorized by your SMTP provider.
SMTP_FROM=
INQUIRY_TO=info@alemaxglobal.com

# Enable only behind an ingress that overwrites X-Alemax-Client-IP.
VISIT_STATS_ENABLED=false
VISIT_HASH_SECRET=
